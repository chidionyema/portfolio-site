# Copy to .env.local for local dev:
#   cp .env.example .env.local
#
# These point Astro's demo client at a backend. For local dev with the
# ritualworks monolith on Aspire, the AppHost pins the API to :5050 (http)
# and :5051 (https) — see ritualworks/src/haworks.AppHost/Program.cs.
#
# Why not :5000? Modern macOS Control Center (AirPlay Receiver) squats on
# :5000 by default. :5050 is conventionally free.

# Base URL for REST calls from the demo client (src/lib/api/demo-client.ts)
PUBLIC_API_URL=http://localhost:5050

# SignalR hub URL (src/lib/api/signalr.ts) — same host, /hubs/demo path
PUBLIC_SIGNALR_URL=http://localhost:5050/hubs/demo
