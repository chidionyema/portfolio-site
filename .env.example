# Copy to .env.local for local dev:
#   cp .env.example .env.local
#
# These point Astro's demo client at a backend. Both the haworks monolith
# (feature/ha-portfolio-integration) and haworks-platform's bff-web
# microservice pin the API to :5050 (http) / :5051 (https), so this single
# pair works for either backend. Switch by stopping one Aspire AppHost and
# starting the other.
#
# Why not :5000? Modern macOS Control Center (AirPlay Receiver) squats on
# :5000 by default. :5050 is conventionally free.

# Base URL for REST calls from the demo client (src/lib/api/demo-client.ts)
PUBLIC_API_URL=http://localhost:5050

# SignalR hub URL (src/lib/api/signalr.ts) — same host, /hubs/demo path
PUBLIC_SIGNALR_URL=http://localhost:5050/hubs/demo

# Cluster label rendered in the hero strip + status bar. Defaults to
# "demo_cluster" in code if unset. Set to LHR_01 to claim a real region/cluster id.
PUBLIC_CLUSTER_LABEL=local_dev
