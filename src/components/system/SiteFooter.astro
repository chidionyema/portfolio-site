---
const year = new Date().getFullYear();
const repoUrl = 'https://github.com/chidionyema/haworks-platform';
---

<footer class="border-t border-border bg-base py-12 mt-24">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Column 1: About -->
      <div>
        <p class="font-display text-lg text-primary mb-3">Chidi Onyema</p>
        <p class="text-sm text-muted leading-relaxed">
          Principal Backend Engineer. London / Remote.
        </p>
      </div>

      <!-- Column 2: Links -->
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted font-bold mb-3">Explore</p>
        <nav class="flex flex-col gap-2 text-sm">
          <a href="/demos" class="text-secondary hover:text-primary transition-colors">Live Demos</a>
          <a href="/architecture" class="text-secondary hover:text-primary transition-colors">Architecture</a>
          <a href="/about" class="text-secondary hover:text-primary transition-colors">About</a>
          <a href="/contact" class="text-secondary hover:text-primary transition-colors">Get in touch</a>
        </nav>
      </div>

      <!-- Column 3: Source -->
      <div>
        <p class="text-[10px] uppercase tracking-widest text-muted font-bold mb-3">Source</p>
        <p class="text-sm text-secondary leading-relaxed mb-3">
          The platform and all demos are open source.
        </p>
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-accent hover:underline">
          View on GitHub &rarr;
        </a>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-border">
      <p class="text-[10px] text-muted">&copy; {year} Chidi Onyema</p>
    </div>
  </div>
</footer>
