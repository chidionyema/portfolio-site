---
/**
 * PanelHeader — editorial section heading.
 *
 * Used by every content section so the page reads as one article
 * with consistent typographic rhythm. Replaces the prior all-caps
 * mono section labels (`Console_Access // Infrastructure_Registry_v1.0`,
 * `IDENTITY_SNAPSHOT`, etc) with sentence-case English in the same
 * Fraunces serif as the hero.
 */

interface Props {
  eyebrow: string;
  title: string;
  summary?: string;
}

const { eyebrow, title, summary } = Astro.props;
---

<header class="container-prose px-6 lg:px-8 mb-12">
  <div class="text-xs font-medium uppercase tracking-[0.18em] text-accent mb-4">
    {eyebrow}
  </div>
  <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-primary font-semibold leading-[1.1] tracking-tight mb-5">
    {title}
  </h2>
  {summary && (
    <p class="text-lg text-secondary leading-relaxed max-w-2xl">
      {summary}
    </p>
  )}
</header>
