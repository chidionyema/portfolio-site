---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/hero/HeroLite';
import { DemoHub } from '../components/demo/DemoHubLite';
import { allDemos } from '../components/demo/DemoSidebar';
import DeepDivesGrid from '../components/architecture/DeepDivesGrid.astro';
import { CommandPalette } from '../components/system/CommandPalette';
import { GIT_SHA, BUILT_AT, sourceUrl } from '../lib/build-info';
import { DEMO_SECTION_HEADING, DEMO_SECTION_SUBHEAD, CLUSTER_LABEL } from '../lib/copy';
import { getMetricsSnapshot } from '../lib/api/demo-client';

import { Scorecard } from '../components/quality/Scorecard';
import { GrafanaPanel } from '../components/metrics/GrafanaPanel';
import { LiveTopologyMap } from '../components/architecture/LiveTopologyMap';
import PanelHeader from '../components/system/PanelHeader.astro';

const initialMetrics = await getMetricsSnapshot().catch(() => undefined);
const dd = await getCollection('deep-dives', ({ data }) => !data.draft);
dd.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const firstDive = dd[0];

const heroPreview = firstDive ? {
  firstDive: {
    slug: firstDive.slug,
    title: firstDive.data.title,
    description: firstDive.data.description,
    readingTime: firstDive.data.readingTime,
  },
  demoCount: allDemos.length,
  diveCount: dd.length,
} : null;

const deepDives = dd.map((e) => ({
  slug: e.slug,
  title: e.data.title,
  description: e.data.description,
  iconKey: e.data.iconKey,
}));
---

<BaseLayout>
  <main>
    <!-- Hero - Critical, loads immediately but lightweight -->
    {heroPreview && <Hero preview={heroPreview} initialMetrics={initialMetrics} client:load />}



    <!-- "Inspect the work" — the live cluster + demos sit here as
         supporting proof, not as the main artefact. The hero already
         did the conversion work; this is for the technical reviewer
         who wants to verify the depth before recommending. -->
    <section id="demo" class="py-20 bg-black border-t border-white/10">
      <div class="container mx-auto px-4" data-reveal>
        <PanelHeader
          eyebrow="Inspect the work"
          title="The site itself is the demo"
          summary="A real .NET 9 cluster on Aspire. Topology below shows what's running right now — click any service or infra node to fault-inject a 30-second pause and watch the demos route around it. Each pattern below proxies to a real backend; click View source on any demo to read the production code."
        />
        <!-- Live cluster topology: the proof artefact -->
        <div class="mb-12">
          <LiveTopologyMap client:load />
        </div>
        <DemoHub client:load />
      </div>
    </section>

    <!-- Metrics panel — Grafana throughput + p99 latency live from the
         cluster. Sits between Operations and Runbooks because it's the
         monitoring view of the same system the demos drove. -->
    <section id="architecture" class="py-20 bg-[#050505] border-t border-white/5">
      <div class="container mx-auto px-4" data-reveal>
        <PanelHeader
          eyebrow="Telemetry"
          title="What the cluster is doing right now"
          summary="Prometheus + OpenTelemetry through Grafana Cloud. Same data the on-call dashboard would show; embedded here because the demos above are what's generating it."
        />
        <div class="grid md:grid-cols-2 gap-6">
          <GrafanaPanel panelId={1} title="Throughput (RPS)" height={240} client:visible />
          <GrafanaPanel panelId={2} title="P99 Latency (ms)" height={240} client:visible />
        </div>
      </div>
    </section>

    <!-- Deep dives — the long-form runbooks behind specific patterns. -->
    <section id="deep-dives" class="py-20 bg-[#050505] border-t border-white/5">
      <div class="container mx-auto px-4" data-reveal>
        <PanelHeader
          eyebrow="Runbooks"
          title="How each pattern is built"
          summary="Long-form write-ups: the saga state machine, transactional outbox, Vault dynamic credentials. The depth a hiring reviewer wants after the demos."
        />
        <DeepDivesGrid />
      </div>
    </section>

    <!-- On call panel — operator card, replaces the prior multi-panel
         about/availability/scorecard slab. One coherent panel that reads
         as "who's on the other end of the pager". -->
    <section id="about" class="py-20 bg-black border-t border-white/5">
      <div class="container mx-auto px-4" data-reveal>
        <PanelHeader
          eyebrow="On call"
          title="Who runs this cluster"
          summary="Senior .NET engineering contractor. London-based. Open for engagements building or stabilising distributed systems at production scale."
        />
        <div class="grid lg:grid-cols-[1fr_360px] gap-10 items-start">
          <div class="space-y-8">
            <p class="text-secondary text-base leading-relaxed max-w-2xl">
              I build distributed .NET systems that stay alive under load —
              the kind where event-driven choreography, idempotency,
              optimistic concurrency, and dynamic-credentials rotation
              aren't whiteboard concepts but the actual production code.
              The cluster above is a representative example: the same
              patterns I've shipped to UK government services, security
              platforms with 10m+ events/day, fintech, and healthtech
              backends.
            </p>

            <ul class="space-y-4 text-sm text-secondary leading-relaxed">
              <li class="grid grid-cols-[120px_1fr] gap-6 border-b border-white/5 pb-4">
                <span class="text-muted font-mono text-[11px] uppercase tracking-widest">2024 — 2026</span>
                <span><strong class="text-primary">Contract.</strong> UK government services. Legacy modernisation; event-driven rebuilds of critical services.</span>
              </li>
              <li class="grid grid-cols-[120px_1fr] gap-6 border-b border-white/5 pb-4">
                <span class="text-muted font-mono text-[11px] uppercase tracking-widest">2022 — 2024</span>
                <span><strong class="text-primary">Tech lead.</strong> Security platform handling 10m+ events/day. Distributed NOC, on-call rotation.</span>
              </li>
              <li class="grid grid-cols-[120px_1fr] gap-6">
                <span class="text-muted font-mono text-[11px] uppercase tracking-widest">Before that</span>
                <span><strong class="text-primary">Stints across</strong> fintech, healthtech, and e-commerce on .NET stacks; production on-call rotations throughout.</span>
              </li>
            </ul>

            <div class="pt-6 border-t border-white/5">
              <div class="text-[10px] font-mono uppercase tracking-[0.3em] text-muted mb-4">Lighthouse audit · this site</div>
              <Scorecard client:visible />
            </div>

            <p class="text-[10px] font-mono text-muted/60 leading-relaxed max-w-2xl uppercase tracking-widest italic">
              Deployment history is sanitised for security. Specific technical references available on request.
            </p>
          </div>

          <aside class="space-y-4">
            <div class="surface p-6 space-y-5">
              <div>
                <div class="text-[10px] font-mono uppercase tracking-[0.3em] text-success mb-1 flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse" />
                  Available
                </div>
                <div class="text-xl font-bold text-primary">Open for contracts</div>
              </div>
              <a
                href="mailto:hello@chidionyema.dev"
                class="block w-full py-3 bg-primary text-black text-center font-bold text-sm rounded-lg hover:bg-white transition-colors"
              >
                Get in touch
              </a>
              <div class="grid grid-cols-1 gap-2 text-[11px]">
                <a href="/cv.pdf" download class="py-2.5 px-3 border border-white/10 text-muted hover:text-primary hover:bg-white/5 transition-all rounded-lg flex items-center justify-between">
                  <span>CV (PDF)</span>
                  <span class="text-muted/40">↓</span>
                </a>
                <a href="https://github.com/chidionyema" target="_blank" rel="noopener" class="py-2.5 px-3 border border-white/10 text-muted hover:text-primary hover:bg-white/5 transition-all rounded-lg flex items-center justify-between">
                  <span>GitHub</span>
                  <span class="text-muted/40">↗</span>
                </a>
                <a href="https://linkedin.com/in/chidionyema" target="_blank" rel="noopener" class="py-2.5 px-3 border border-white/10 text-muted hover:text-primary hover:bg-white/5 transition-all rounded-lg flex items-center justify-between">
                  <span>LinkedIn</span>
                  <span class="text-muted/40">↗</span>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Footer — quiet brag: build SHA, last-updated, source -->
    <footer class="py-10 border-t border-border">
      <div class="container mx-auto px-4 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="text-xs font-mono text-muted flex flex-wrap items-center gap-x-5 gap-y-1.5">
          <span>© Chidi Onyema</span>
          <a href={sourceUrl()} target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
            source
          </a>
          <a href={sourceUrl(`commit/${GIT_SHA}`)} target="_blank" rel="noopener" class="hover:text-secondary transition-colors uppercase tracking-wider">
            build {GIT_SHA.slice(0, 7)}
          </a>
          <span class="uppercase tracking-wider">
            updated {new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(new Date(BUILT_AT))}
          </span>
        </div>
        <a href="#" class="text-xs text-muted hover:text-secondary transition-colors">Top ↑</a>
      </div>
    </footer>

    <CommandPalette deepDives={deepDives} client:idle />
  </main>
</BaseLayout>
