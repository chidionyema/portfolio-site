---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/hero/HeroLite';
import { CredibilityStrip } from '../components/home/CredibilityStrip';
import { Challenges } from '../components/home/Challenges';
import { SagaAnimation } from '../components/home/SagaAnimation';
import { Dives } from '../components/home/Dives';
const dd = await getCollection('deep-dives', ({ data }) => !data.draft);
dd.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const dives = dd.slice(0, 3).map((e) => ({
  slug: e.id,
  title: e.data.title,
  description: e.data.description,
  readingTime: e.data.readingTime + ' min read',
}));
---

<BaseLayout>
  <main>
    <Hero client:load />
    <CredibilityStrip client:visible />
    <Challenges client:visible />
    <SagaAnimation client:visible />
    <Dives dives={dives} client:visible />
  </main>
</BaseLayout>
