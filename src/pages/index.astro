---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/hero/HeroLite';
import { DemoHub } from '../components/demo/DemoHubLite';
import { allDemos } from '../components/demo/DemoSidebar';
import DeepDivesGrid from '../components/architecture/DeepDivesGrid.astro';
import { CommandPalette } from '../components/system/CommandPalette';
import { GIT_SHA, BUILT_AT, sourceUrl } from '../lib/build-info';
import { DEMO_SECTION_HEADING, DEMO_SECTION_SUBHEAD, CLUSTER_LABEL } from '../lib/copy';
import { getMetricsSnapshot } from '../lib/api/demo-client';

import { Scorecard } from '../components/quality/Scorecard';
import { TopologyMap } from '../components/architecture/TopologyMap';
import { GrafanaPanel } from '../components/metrics/GrafanaPanel';

const initialMetrics = await getMetricsSnapshot().catch(() => undefined);
const dd = await getCollection('deep-dives', ({ data }) => !data.draft);
dd.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const firstDive = dd[0];

const heroPreview = firstDive ? {
  firstDive: {
    slug: firstDive.slug,
    title: firstDive.data.title,
    description: firstDive.data.description,
    readingTime: firstDive.data.readingTime,
  },
  demoCount: allDemos.length,
  diveCount: dd.length,
} : null;

const deepDives = dd.map((e) => ({
  slug: e.slug,
  title: e.data.title,
  description: e.data.description,
  iconKey: e.data.iconKey,
}));
---

<BaseLayout>
  <main>
    <!-- Hero - Critical, loads immediately but lightweight -->
    {heroPreview && <Hero preview={heroPreview} initialMetrics={initialMetrics} client:load />}



    <!-- Demo Section - Only hydrates when visible -->
    <section id="demo" class="py-24 bg-black border-t border-white/10">
      <div class="container mx-auto px-4" data-reveal>
        <div class="mb-12 flex items-center justify-between font-mono">
           <div className="flex items-center gap-4">
              <div className="px-3 py-1 bg-accent text-white font-black text-[10px] uppercase tracking-[0.2em]">
                 Console_Access
              </div>
              <h2 class="text-xl text-primary uppercase font-black tracking-tighter">
                Infrastructure_Registry_v1.0
              </h2>
           </div>
           <div class="hidden md:flex items-center gap-2 text-[9px] text-muted uppercase font-bold tracking-widest">
              <div class="w-1 h-1 bg-success animate-pulse" />
              Cluster_Healthy // {CLUSTER_LABEL}
           </div>
        </div>
        <DemoHub client:visible />
      </div>
    </section>

    <!-- Architecture Section -->
    <section id="architecture" class="py-24 bg-[#050505] border-t border-white/5">
      <div class="container mx-auto px-4" data-reveal>
        <div class="grid lg:grid-cols-[1fr_400px] gap-12 items-start">
          <div class="space-y-8">
            <div class="text-left border-l-2 border-accent pl-6">
              <h2 class="font-mono text-display-md text-primary mb-4 uppercase font-black tracking-tighter">
                Distributed_Topology
              </h2>
              <p class="text-sm font-mono text-muted max-w-2xl uppercase tracking-widest leading-relaxed">
                Real-time visualization of the .NET 9 microservices cluster and infrastructure nodes.
              </p>
            </div>
            <TopologyMap client:visible />
          </div>

          <div class="space-y-6 pt-12">
            <GrafanaPanel panelId={1} title="Throughput (RPS)" height={220} client:visible />
            <GrafanaPanel panelId={2} title="P99 Latency (ms)" height={220} client:visible />
            <div class="p-6 glass-subtle border border-white/5 font-mono">
              <p class="text-[10px] text-muted leading-relaxed uppercase tracking-widest italic">
                Direct Grafana Cloud integration. Data source: Prometheus + OpenTelemetry.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep Dives -->
    <section id="deep-dives" class="py-24 bg-[#050505] border-t border-white/5">
      <div class="container mx-auto px-4" data-reveal>
        <div class="text-left mb-16 border-l-2 border-white/20 pl-6">
          <h2 class="font-mono text-display-md text-primary mb-4 uppercase font-black tracking-tighter">
            Technical_Specifications
          </h2>
          <p class="text-sm font-mono text-muted max-w-2xl uppercase tracking-widest leading-relaxed">
            Long-form architectural analysis and pattern implementations.
          </p>
        </div>
        <DeepDivesGrid />
      </div>
    </section>

    <!-- About section -->
    <section id="about" class="py-32 bg-black border-t border-white/5">
      <div class="container mx-auto px-4 max-w-5xl" data-reveal>
        <div class="font-mono text-[10px] uppercase tracking-[0.4em] text-accent mb-8">
          IDENTITY_SNAPSHOT // CHIDI_ONYEMA // {CLUSTER_LABEL}_NODE
        </div>
        
        <div class="grid lg:grid-cols-[1fr_400px] gap-20">
          <div>
            <h2 class="font-mono text-display-md text-primary mb-12 uppercase font-black tracking-tighter leading-[0.9]">
              Distributed .NET <br/> clusters, built <br/> for production.
            </h2>

            <p class="text-secondary font-mono text-sm leading-relaxed mb-16 max-w-xl opacity-80 uppercase tracking-tight">
              Senior contractor for distributed systems that stay alive under load.
              This platform is a live cluster: every module targets a .NET 9 kernel on Fly.io, 
              backed by Neon PostgreSQL, Upstash Redis, and CloudAMQP. 
              The telemetry you see is live SignalR traffic from the {CLUSTER_LABEL} region.
            </p>

            <!-- Receipts. -->
            <div class="border-t border-white/10 pt-10">
              <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted mb-8 font-black">
                DEPLOYMENT_HISTORY
              </div>
              <ul class="space-y-6 text-[11px] font-mono text-secondary uppercase tracking-tight">
                <li class="grid grid-cols-[140px_1fr] gap-6 border-b border-white/[0.03] pb-6">
                  <span class="text-muted/60 font-black">2024 — 2026</span>
                  <span><span class="text-primary font-black">[CONTRACT]</span> UK GOV SERVICES // LEGACY MIGRATION // EVENT_DRIVEN_REBUILDS</span>
                </li>
                <li class="grid grid-cols-[140px_1fr] gap-6 border-b border-white/[0.03] pb-6">
                  <span class="text-muted/60 font-black">2022 — 2024</span>
                  <span><span class="text-primary font-black">[LEAD]</span> SECURITY PLATFORM // 10M+ EVENTS_DAY // DISTRIBUTED_NOC</span>
                </li>
                <li class="grid grid-cols-[140px_1fr] gap-6">
                <span class="text-muted/60 font-black">PRE_2022</span>
                <span>FINTECH // HEALTHTECH // E-COMMERCE // .NET_STACK // ON_CALL_ROTATIONS</span>
                </li>
                </ul>
                </div>

                <!-- Quality Scorecard -->
                <div class="mt-20">
                <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted mb-8 font-black">
                QUALITY_ASSURANCE // LIGHTHOUSE_CI
                </div>
                <Scorecard client:visible />
                </div>
                </div>
          <div class="space-y-6">
             <div class="p-8 bg-[#050505] border border-white/10 shadow-2xl font-mono">
                <div class="font-black text-primary text-xl mb-2 uppercase tracking-tighter">Availability</div>
                <div class="text-sm text-secondary mb-8 opacity-60 uppercase tracking-widest">Open for contracts</div>
                
                <div class="space-y-4">
                   <a href="mailto:hello@chidionyema.dev"
                      class="block w-full py-4 bg-primary text-black text-center font-black text-xs uppercase tracking-[0.2em] hover:bg-white transition-colors">
                     [ INITIATE_CONTACT ]
                   </a>
                   <div class="grid grid-cols-1 gap-2">
                      <a href="/cv.pdf" download class="py-3 px-4 border border-white/10 text-[10px] font-black uppercase text-muted hover:text-primary hover:bg-white/5 transition-all text-center tracking-widest">CV_PDF_EXPORT</a>
                      <a href="https://github.com/chidionyema" target="_blank" rel="noopener" class="py-3 px-4 border border-white/10 text-[10px] font-black uppercase text-muted hover:text-primary hover:bg-white/5 transition-all text-center tracking-widest">GITHUB_REPOSITORY</a>
                      <a href="https://linkedin.com/in/chidionyema" target="_blank" rel="noopener" class="py-3 px-4 border border-white/10 text-[10px] font-black uppercase text-muted hover:text-primary hover:bg-white/5 transition-all text-center tracking-widest">LINKEDIN_PROFILE</a>
                   </div>
                </div>
             </div>
             
             <div class="p-6 border border-white/5 font-mono text-[9px] text-muted/60 uppercase leading-relaxed tracking-widest">
                System_Note: Deployment history is sanitized for security. Specific technical references available upon authenticated request.
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer — quiet brag: build SHA, last-updated, source -->
    <footer class="py-10 border-t border-border">
      <div class="container mx-auto px-4 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="text-xs font-mono text-muted flex flex-wrap items-center gap-x-5 gap-y-1.5">
          <span>© Chidi Onyema</span>
          <a href={sourceUrl()} target="_blank" rel="noopener" class="hover:text-secondary transition-colors">
            source
          </a>
          <a href={sourceUrl(`commit/${GIT_SHA}`)} target="_blank" rel="noopener" class="hover:text-secondary transition-colors uppercase tracking-wider">
            build {GIT_SHA.slice(0, 7)}
          </a>
          <span class="uppercase tracking-wider">
            updated {new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium' }).format(new Date(BUILT_AT))}
          </span>
        </div>
        <a href="#" class="text-xs text-muted hover:text-secondary transition-colors">Top ↑</a>
      </div>
    </footer>

    <CommandPalette deepDives={deepDives} client:idle />
  </main>
</BaseLayout>
