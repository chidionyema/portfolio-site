---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/hero/HeroLite';
import { Proof } from '../components/home/Proof';
import { Dives } from '../components/home/Dives';
import { getMetricsSnapshot } from '../lib/api/demo-client';
import { LabBackgroundProber } from '../components/architecture/LabBackgroundProber';

const initialMetrics = await getMetricsSnapshot().catch(() => undefined);
const dd = await getCollection('deep-dives', ({ data }) => !data.draft);
dd.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const dives = dd.slice(0, 3).map((e) => ({
  slug: e.slug,
  title: e.data.title,
  description: e.data.description,
  readingTime: e.data.readingTime + ' min read',
}));
---

<BaseLayout>
  <main>
    <Hero client:load initialMetrics={initialMetrics} />
    <LabBackgroundProber client:only="react" />
    <Proof client:only="react" />
    <Dives dives={dives} client:load />
  </main>
</BaseLayout>
