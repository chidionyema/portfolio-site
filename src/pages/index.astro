---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/hero/HeroLite';
import { DemoHub } from '../components/demo/DemoHubLite';
---

<BaseLayout>
  <main>
    <!-- Hero - Critical, loads immediately but lightweight -->
    <Hero client:load />

    <!-- Demo Section - Only hydrates when visible -->
    <section id="demo" class="py-24">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-primary mb-4">
            See It Working
          </h2>
          <p class="text-lg text-secondary max-w-2xl mx-auto">
            Watch real events flow through a distributed system.
          </p>
        </div>
        <DemoHub client:visible />
      </div>
    </section>

    <!-- Architecture Section - Static HTML, no JS -->
    <section id="architecture" class="py-24 bg-surface">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-primary mb-4">
            System Architecture
          </h2>
          <p class="text-lg text-secondary max-w-2xl mx-auto">
            5 bounded contexts, event-driven, zero coupling.
          </p>
        </div>
        <div class="glass rounded-2xl p-8">
          <div class="grid md:grid-cols-5 gap-4 text-center">
            {['Catalog', 'Orders', 'Payments', 'Content', 'Identity'].map((ctx) => (
              <div class="p-4 bg-surface rounded-xl border border-border hover:border-accent transition-colors">
                <div class="text-2xl mb-2">
                  {ctx === 'Catalog' && '📦'}
                  {ctx === 'Orders' && '🛒'}
                  {ctx === 'Payments' && '💳'}
                  {ctx === 'Content' && '📄'}
                  {ctx === 'Identity' && '🔐'}
                </div>
                <div class="font-medium text-primary">{ctx}</div>
                <div class="text-xs text-muted mt-1">Bounded Context</div>
              </div>
            ))}
          </div>
          <div class="mt-8 flex justify-center gap-8 text-sm text-secondary">
            <div class="flex items-center gap-2">
              <div class="w-8 h-0.5 bg-accent"></div>
              <span>Events via RabbitMQ</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-success"></div>
              <span>Transactional Outbox</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep Dives - Static HTML -->
    <section id="deep-dives" class="py-24">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-4xl font-bold text-primary mb-4">
            Technical Deep-Dives
          </h2>
          <p class="text-lg text-secondary max-w-2xl mx-auto">
            How I built it, and why.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { title: 'Transactional Outbox', icon: '📤', desc: 'Guaranteed event delivery with atomicity' },
            { title: 'CQRS with MediatR', icon: '⚡', desc: 'Separating reads from writes at scale' },
            { title: 'Circuit Breakers', icon: '🔌', desc: 'Protecting services from cascade failures' },
            { title: 'Vault Rotation', icon: '🔐', desc: 'Zero-downtime credential management' },
            { title: 'Testing EDA', icon: '🧪', desc: '1400+ tests for event-driven systems' },
            { title: 'Clean Architecture', icon: '🏗️', desc: 'Dependency rules that actually work' },
          ].map((item) => (
            <a href={`/deep-dives/${item.title.toLowerCase().replace(/ /g, '-')}`}
               class="glass rounded-xl p-6 hover:-translate-y-1 hover:border-accent/50 transition-all group">
              <div class="text-3xl mb-3">{item.icon}</div>
              <h3 class="text-lg font-semibold text-primary mb-2 group-hover:text-accent transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-secondary">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- About - Static HTML -->
    <section id="about" class="py-24 bg-surface">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-4xl font-bold text-primary mb-6">Chidi Onyema</h2>
          <p class="text-xl text-secondary mb-4">Senior .NET Contractor · London</p>
          <p class="text-secondary mb-8 leading-relaxed">
            20 years building software. I write code daily and lead teams.
            Recent work: migrating legacy systems to .NET Core, security platforms
            processing millions of events, UK Government services.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/cv.pdf" download
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-accent to-accent-light text-white font-medium hover:shadow-lg hover:shadow-accent/25 transition-all">
              Download CV
            </a>
            <a href="https://github.com/chidionyema" target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-secondary hover:text-primary hover:border-accent transition-all">
              GitHub
            </a>
            <a href="https://linkedin.com/in/chidionyema" target="_blank" rel="noopener"
               class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-secondary hover:text-primary hover:border-accent transition-all">
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer - Static -->
    <footer class="py-8 border-t border-border">
      <div class="container mx-auto px-4 text-center text-sm text-muted">
        <p>Built with .NET 9, Astro, and determination.</p>
      </div>
    </footer>
  </main>
</BaseLayout>
