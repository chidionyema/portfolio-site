---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Heading } from '../components/ui/Heading';
import { Container } from '../components/ui/Container';
import { Stack } from '../components/ui/Stack';
---

<BaseLayout title="About | Chidi Onyema" description="Principal Backend Engineer. 13+ years building distributed systems. London-based, remote-friendly.">
  <main class="pt-32 pb-24">
    <Container size="prose">
      <Stack gap={12}>
        <div>
          <Heading variant="hero" level={1}>About me</Heading>
          <p class="text-xl text-secondary leading-relaxed mt-6">
            I'm a Principal Backend Engineer based in London. I specialize in distributed systems
            that handle real money, real users, and real failure modes.
          </p>
        </div>

        <div class="prose prose-primary max-w-none">
          <h2 class="text-lg font-semibold text-primary">What I do</h2>
          <p class="text-secondary">
            I design and build microservice platforms where payments can't silently
            disappear, refunds don't get stuck without escalation, and cache stampedes don't
            take down the database. My focus is on the hard problems: distributed transactions,
            saga orchestration, idempotency, and zero-downtime deployments.
          </p>

          <h2 class="text-lg font-semibold text-primary mt-8">How I work</h2>
          <ul class="text-secondary space-y-2">
            <li><strong>Architecture-first:</strong> I start with failure modes, not happy paths. Every design decision maps to a production failure I've actually seen.</li>
            <li><strong>Automated enforcement:</strong> 159 architecture guards and 50 Roslyn analyzers catch violations at compile time, not in code review.</li>
            <li><strong>Observable by default:</strong> OpenTelemetry tracing, structured logging, and health endpoints on every service.</li>
            <li><strong>Test pyramid:</strong> Unit, Integration, Contract, and E2E. 13 CI suites, all green.</li>
          </ul>

          <h2 class="text-lg font-semibold text-primary mt-8">This portfolio</h2>
          <p class="text-secondary">
            This isn't a static site with screenshots. It's a live .NET 9 cluster with 8 microservices
            on Fly.io, PostgreSQL on Supabase, RabbitMQ on CloudAMQP, and Redis on Upstash. Every demo
            hits real infrastructure. The source is on
            <a href="https://github.com/chidionyema/haworks-platform" target="_blank" class="text-accent hover:underline">GitHub</a>.
          </p>

          <h2 class="text-lg font-semibold text-primary mt-8">Education & Certifications</h2>
          <ul class="text-secondary space-y-2">
            <li><strong>Professional Certificate in AI and Machine Learning</strong>, Imperial College Business School (2024)</li>
            <li><strong>BSc (Hons) Computer Science</strong>, Queen Mary University of London</li>
          </ul>

          <h2 class="text-lg font-semibold text-primary mt-8">Stack</h2>
          <div class="flex flex-wrap gap-2 not-prose">
            {['C# / .NET 9', 'MassTransit', 'EF Core', 'PostgreSQL', 'RabbitMQ', 'Redis', 'Polly', 'HashiCorp Vault', 'Docker', 'Fly.io', 'Supabase', 'OpenTelemetry', 'xUnit', 'Pact', 'Aspire', 'AI / ML'].map(tech => (
              <span class="px-2.5 py-1 bg-surface-warm border border-border rounded text-[10px] uppercase tracking-wider font-mono text-muted">{tech}</span>
            ))}
          </div>

          <h2 class="text-lg font-semibold text-primary mt-8">Availability</h2>
          <p class="text-secondary">
            Currently available for contract engagements. London-based, comfortable with
            remote and hybrid. Day rate on request.
          </p>
          <p class="mt-4">
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold bg-primary text-base-inverse hover:bg-secondary transition-all">
              Get in touch
            </a>
          </p>
        </div>
      </Stack>
    </Container>
  </main>
</BaseLayout>
