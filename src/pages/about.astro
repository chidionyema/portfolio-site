---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Heading } from '../components/ui/Heading';
import { Container } from '../components/ui/Container';
import { Stack } from '../components/ui/Stack';
---

<BaseLayout title="About | Chidi Onyema">
  <main class="pt-32 pb-24">
    <Container size="prose">
      <Stack gap={12}>
        <Heading variant="hero" level={1}>Senior .NET engineer based in London.</Heading>
        <div class="prose prose-primary">
          <p class="text-xl text-secondary leading-relaxed">
            I specialize in building and stabilizing distributed systems. 
            My work focuses on resilience, consistency, and performance at scale.
          </p>
          <p>
            Currently available for contract engagements.
          </p>
        </div>
      </Stack>
    </Container>
  </main>
</BaseLayout>
