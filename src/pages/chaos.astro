---
// /chaos — the always-on canvas.
//
// The BFF's JourneyScheduler fires a rotating canonical journey every ~20s
// (place-order saga / idempotent retry / OCC race). The JourneyCanvas
// component locks onto each one via OnJourneyStart/OnJourneyEnd and renders
// a per-journey side panel beside the live topology.
//
// Above the canvas: the receipts row (recovery time / data loss / sagas
// compensated) — the screenshot-survives moment.
//
// Below the canvas: a single collapsible "Show technical detail" drawer
// containing the dense legacy panels (request feed, scoreboard, runners,
// metrics, sparklines). Default closed; engineers can expand to inspect
// raw signals.
//
// Every island is `client:only="react"` to bypass the SSR break documented
// in lab.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import { JourneyCanvas } from '../components/architecture/JourneyCanvas';
import { LabBackgroundProber } from '../components/architecture/LabBackgroundProber';
import { LabAutoRunners } from '../components/architecture/LabAutoRunners';
import { LabRequestFeed } from '../components/architecture/LabRequestFeed';
import { ChaosImpactBanner } from '../components/architecture/ChaosImpactBanner';
import { LiveSparklines } from '../components/architecture/LiveSparklines';
import { LiveMetricsPanel } from '../components/architecture/LiveMetricsPanel';
import { ResilienceScoreboard } from '../components/architecture/ResilienceScoreboard';
import { ChaosTimelineStrip } from '../components/architecture/ChaosTimelineStrip';
import { ChaosReceipts } from '../components/architecture/ChaosReceipts';
import { ChaosDrillController } from '../components/architecture/ChaosDrillController';
import TechnicalDetailDrawer from '../components/architecture/TechnicalDetailDrawer.astro';
---

<BaseLayout
  title="Chaos — Chidi Onyema"
  description="The .NET 9 cluster behind this site, watched end-to-end. A rotating canonical journey runs every 20s. Pause anything in the topology and the canvas adapts in real time."
>
  <main>
    <!-- Hero. Short. The canvas does the talking. -->
    <section class="py-16 lg:py-20 border-b border-border">
      <div class="container-prose px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors mb-8"
        >
          ← Back home
        </a>
        <div class="text-xs font-medium uppercase tracking-[0.18em] text-accent mb-4">
          Chaos
        </div>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-primary font-semibold leading-[1.05] tracking-tight mb-5">
          Pause anything. Watch it heal.
        </h1>
        <p class="text-lg text-secondary leading-relaxed max-w-2xl">
          A rotating canonical journey runs through the cluster every 20
          seconds — place-order saga, idempotent retry, OCC race. Watch
          the saga state machine resolve, the same idempotency key dedupe
          across replays, five concurrent writes pick exactly one winner.
          Click any node in the topology to fault-inject; the canvas
          adapts in real time.
        </p>
      </div>
    </section>

    <!-- Background prober — invisible. Ensures continuous baseline traffic. -->
    <LabBackgroundProber client:only="react" />

    <!-- Mode toggle (drill auto-loops chaos pauses, drive lets the visitor
         click). The JourneyScheduler runs independently of either mode. -->
    <section class="container px-6 lg:px-8 pt-6 pb-2">
      <ChaosDrillController client:only="react" />
    </section>

    <!-- Receipts row — recovery time, data loss, sagas compensated.
         The screenshot-survives moment. Above the canvas because it's
         the answer; the canvas is the evidence. -->
    <section class="container px-6 lg:px-8 pt-4 pb-2" data-reveal>
      <div class="text-[10px] uppercase tracking-[0.22em] text-accent mb-3">
        Recovery proof · last cycle
      </div>
      <ChaosReceipts client:only="react" />
    </section>

    <!-- The canvas — topology + journey side panel + lifecycle timeline.
         The dominant element of the page. -->
    <section class="py-8 lg:py-10" data-reveal>
      <div class="container px-6 lg:px-8 space-y-4">
        <ChaosTimelineStrip client:only="react" />
        <JourneyCanvas client:only="react" />
        <ChaosImpactBanner client:only="react" />
      </div>
    </section>

    <!-- Single collapsed drawer below the canvas. Engineers expand to
         inspect raw wire feed + scoreboard + runners + sparklines. -->
    <section class="py-8 lg:py-10 border-t border-border" data-reveal>
      <div class="container px-6 lg:px-8">
        <TechnicalDetailDrawer>
          <div>
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Resilience scoreboard · invariants under load
            </div>
            <ResilienceScoreboard client:only="react" />
          </div>

          <div class="border-t border-white/[0.06] pt-5">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Pattern runners · 9 background loops firing real traffic
            </div>
            <LabAutoRunners client:only="react" />
          </div>

          <div class="border-t border-white/[0.06] pt-5">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Wire feed · every /api/* request the BFF handled
            </div>
            <LabRequestFeed client:only="react" />
          </div>

          <div class="border-t border-white/[0.06] pt-5 grid md:grid-cols-2 gap-6">
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                Live measurements · trailing 30s
              </div>
              <LiveMetricsPanel client:only="react" />
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                RPS + p99 · trailing 60s
              </div>
              <LiveSparklines client:only="react" />
            </div>
          </div>
        </TechnicalDetailDrawer>
      </div>
    </section>

    <!-- Footer return. -->
    <section class="py-16 border-t border-border" data-reveal>
      <div class="container-prose px-6 lg:px-8 text-center space-y-4">
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-5 py-3 bg-primary text-base font-medium rounded-md hover:bg-secondary transition-colors"
          style="color: rgb(var(--color-base))"
        >
          Email me
          <span>→</span>
        </a>
        <div class="text-sm text-muted">
          See how this is built →
          <a href="/lab" class="hover:text-primary transition-colors ml-1">
            /lab — the architecture canvas
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
