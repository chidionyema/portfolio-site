---
// /chaos — chaos engineering demonstration page.
//
// Two modes (toggle at top): Drill (auto-runs a 60s loop on a rotating
// chaos target) and Drive-it-yourself (visitor clicks topology nodes
// to pause manually). The headline element is the Receipts row at
// the bottom — three big numbers + verdicts that update at the end
// of every cycle (recovery time, data loss, sagas compensated).
//
// Every island is `client:only="react"` to dodge the SSR break documented
// in lab.astro. The chaos data plane (cluster-store + signalR) is
// already ssr-safe behind a `typeof window === 'undefined'` guard but
// the lucide-react / signalr import chain still throws under astro
// build's react-renderer.
import BaseLayout from '../layouts/BaseLayout.astro';
import { LiveTopologyMap } from '../components/architecture/LiveTopologyMap';
import { LabBackgroundProber } from '../components/architecture/LabBackgroundProber';
import { LabAutoRunners } from '../components/architecture/LabAutoRunners';
import { LabRequestFeed } from '../components/architecture/LabRequestFeed';
import { ChaosImpactBanner } from '../components/architecture/ChaosImpactBanner';
import { LiveSparklines } from '../components/architecture/LiveSparklines';
import { LiveMetricsPanel } from '../components/architecture/LiveMetricsPanel';
import { ResilienceScoreboard } from '../components/architecture/ResilienceScoreboard';
import { ChaosTimelineStrip } from '../components/architecture/ChaosTimelineStrip';
import { ChaosReceipts } from '../components/architecture/ChaosReceipts';
import { ChaosDrillController } from '../components/architecture/ChaosDrillController';
---

<BaseLayout
  title="Chaos — Chidi Onyema"
  description="Pause anything in the cluster. Watch it heal. Real .NET 9 microservices surviving fault injection in real time, with recovery proof."
>
  <main>
    <!-- Hero — short. The page proves the claim itself. -->
    <section class="py-16 lg:py-20 border-b border-border">
      <div class="container-prose px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors mb-8"
        >
          ← Back home
        </a>
        <div class="text-xs font-medium uppercase tracking-[0.18em] text-accent mb-4">
          Chaos
        </div>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-primary font-semibold leading-[1.05] tracking-tight mb-5">
          Pause anything. Watch it heal.
        </h1>
        <p class="text-lg text-secondary leading-relaxed max-w-2xl">
          The cluster behind this site, surviving real fault injection in
          real time. Drill mode runs a 60-second loop on a rotating target
          — catalog, postgres, rabbitmq, payments. Switch to Drive mode
          to break things yourself.
        </p>
      </div>
    </section>

    <!-- Background prober — invisible. Continuously fires safe GETs so
         the cluster has traffic for the watcher to observe. -->
    <LabBackgroundProber client:only="react" />

    <!-- Mode toggle: drill vs drive. Drives the auto-loop. -->
    <section class="container px-6 lg:px-8 pt-6 pb-2">
      <ChaosDrillController client:only="react" />
    </section>

    <!-- The cluster, live, under attack. Topology + lifecycle timeline
         + chaos lens + wire feed in one shared container. -->
    <section class="py-8 lg:py-10" data-reveal>
      <div class="container px-6 lg:px-8">
        <div class="panel-dark p-6 md:p-10 shadow-2xl space-y-6">
          <ChaosTimelineStrip client:only="react" />
          <LiveTopologyMap client:only="react" />
          <ChaosImpactBanner client:only="react" />
          <div class="border-t border-white/[0.06] pt-6">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Wire feed · every /api/* the BFF handled
            </div>
            <LabRequestFeed client:only="react" />
          </div>
        </div>
      </div>
    </section>

    <!-- Receipts — the headline of /chaos. Three big numbers, three
         verdicts. Updates at the end of every cycle. -->
    <section class="py-8 lg:py-10 border-t border-border" data-reveal>
      <div class="container px-6 lg:px-8">
        <div class="text-[10px] uppercase tracking-[0.22em] text-accent mb-4">
          Recovery proof · last cycle
        </div>
        <ChaosReceipts client:only="react" />
      </div>
    </section>

    <!-- Continuous proof — invariants + pattern runners. The evidence
         that the cluster is always under load, not just during drills. -->
    <section class="py-12 lg:py-14 border-t border-border" data-reveal>
      <div class="container px-6 lg:px-8">
        <div class="text-[10px] uppercase tracking-[0.22em] text-accent mb-4">
          Continuous proof · invariants under load
        </div>
        <div class="panel-dark p-6 md:p-8 shadow-2xl space-y-6">
          <ResilienceScoreboard client:only="react" />
          <div class="border-t border-white/[0.06] pt-6">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Pattern runners · each loop fires its own real traffic
            </div>
            <LabAutoRunners client:only="react" />
          </div>
        </div>
      </div>
    </section>

    <!-- Raw signals — quieter chrome. Live metrics + sparklines. -->
    <section class="py-12 lg:py-14 border-t border-border" data-reveal>
      <div class="container px-6 lg:px-8">
        <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-4">
          Raw signals
        </div>
        <div class="panel-dark p-5 md:p-6 shadow-2xl">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                Live measurements · trailing 30s
              </div>
              <LiveMetricsPanel client:only="react" />
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                RPS + p99 · trailing 60s
              </div>
              <LiveSparklines client:only="react" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer return. CTA + nav back to lab. -->
    <section class="py-16 border-t border-border" data-reveal>
      <div class="container-prose px-6 lg:px-8 text-center space-y-4">
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-5 py-3 bg-primary text-base font-medium rounded-md hover:bg-secondary transition-colors"
          style="color: rgb(var(--color-base))"
        >
          Email me
          <span>→</span>
        </a>
        <div class="text-sm text-muted">
          See how this is built →
          <a href="/lab" class="hover:text-primary transition-colors ml-1">
            /lab — the architecture canvas
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
