---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Heading } from '../components/ui/Heading';
import { Container } from '../components/ui/Container';
import { Card } from '../components/ui/Card';
import { Stack } from '../components/ui/Stack';

const work = await getCollection('work', ({ data }) => !data.draft);
work.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Work | Chidi Onyema">
  <main class="pt-32 pb-24">
    <Container>
      <Stack gap={12}>
        <div class="max-w-2xl">
          <Heading variant="hero" level={1}>Selected Work</Heading>
          <p class="text-xl text-secondary mt-6">
            Substantial projects and case studies from recent engagements.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-8">
          {work.map((project) => (
            <Card key={project.slug} padding="lg" className="hover:border-secondary transition-colors cursor-pointer">
              <div class="flex flex-col md:flex-row justify-between gap-6">
                <div class="space-y-4">
                  <div class="text-xs uppercase tracking-widest text-accent font-semibold">{project.data.company} · {project.data.period}</div>
                  <Heading variant="section">{project.data.title}</Heading>
                  <p class="text-secondary max-w-2xl">{project.data.description}</p>
                  <div class="flex flex-wrap gap-2 pt-4">
                    {project.data.technologies.map((tech) => (
                      <span class="px-2 py-1 bg-surface-warm border border-border rounded text-[10px] uppercase tracking-wider font-mono text-muted">{tech}</span>
                    ))}
                  </div>
                </div>
              </div>
            </Card>
          ))}
        </div>
      </Stack>
    </Container>
  </main>
</BaseLayout>
