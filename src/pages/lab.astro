---
// TODO(revisit): every island on /lab is `client:only="react"` to bypass SSR.
// The cluster-store + useSyncExternalStore + signalR import chain triggers a
// React "Invalid hook call" warning during SSR that ends up returning just
// `<!DOCTYPE html>` (15 bytes) instead of the rendered tree. Symptoms:
//   • /lab returns 15 bytes from `astro dev` and `astro build` SSR
//   • /index renders fine — uses the same store but lighter component tree
// Likely culprit: dual React copy at SSR time (lucide-react + signalr both
// pulling React via different module paths under vite's optimizeDeps). Worth
// investigating once Aspire is stable. For now `client:only` ships the page.
//
// Page architecture: three zones, shared containers, one timeline spine.
//   WATCH   — lifecycle timeline + topology + chaos banner + request feed
//   PROVE   — invariants (scoreboard) + pattern runners
//   INSPECT — raw signals (metrics + sparklines) + interactive demos
// Every panel currently kept; reorganization is grouping + hierarchy, not
// demolition.
import BaseLayout from '../layouts/BaseLayout.astro';
import { DemoHub } from '../components/demo/DemoHubLite';
import { LiveTopologyMap } from '../components/architecture/LiveTopologyMap';
import { LiveMetricsPanel } from '../components/architecture/LiveMetricsPanel';
import { LabBackgroundProber } from '../components/architecture/LabBackgroundProber';
import { LabAutoRunners } from '../components/architecture/LabAutoRunners';
import { LabRequestFeed } from '../components/architecture/LabRequestFeed';
import { ChaosImpactBanner } from '../components/architecture/ChaosImpactBanner';
import { LiveSparklines } from '../components/architecture/LiveSparklines';
import { ResilienceScoreboard } from '../components/architecture/ResilienceScoreboard';
import { ChaosTimelineStrip } from '../components/architecture/ChaosTimelineStrip';
import PanelHeader from '../components/system/PanelHeader.astro';
---

<BaseLayout
  title="Lab — Chidi Onyema"
  description="Live cluster: real .NET 9 microservices, real Postgres / RabbitMQ / Redis / Vault, real chaos controls. Inspect the patterns from chidionyema.dev."
>
  <main>
    <!-- Lab header — short. The page's job is to be the proof; the prose
         is just enough to frame what follows. -->
    <section class="py-16 lg:py-20 border-b border-border">
      <div class="container-prose px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors mb-8"
        >
          ← Back home
        </a>
        <div class="text-xs font-medium uppercase tracking-[0.18em] text-accent mb-4">
          Lab
        </div>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-primary font-semibold leading-[1.05] tracking-tight mb-5">
          The live cluster.
        </h1>
        <p class="text-lg text-secondary leading-relaxed max-w-2xl">
          Real .NET 9 microservices, Postgres, RabbitMQ, Redis, Vault.
          Click any node to fault-inject a 30-second pause and watch the
          cluster survive and recover. The page does not narrate — it
          shows.
        </p>
      </div>
    </section>

    <!-- Background prober — invisible. Continuously fires safe GETs so
         the cluster has traffic for the watcher to observe even when
         the visitor is idle. -->
    <LabBackgroundProber client:only="react" />

    <!-- ─────────────────────────────────────────────────────────────
         ZONE 1 — WATCH the live cluster
         Timeline spine + topology + chaos banner + request feed in
         one shared container. Single time signature for all four.
         ───────────────────────────────────────────────────────────── -->
    <section class="py-12 lg:py-14" data-reveal>
      <PanelHeader
        eyebrow="Watch"
        title="The live cluster, right now."
        summary="Pause anything in the topology — the lifecycle timeline names every phase as it happens, the banner identifies the failing request, the wire feed scrolls the actual /api/* traffic. One time signature."
      />
      <div class="container px-6 lg:px-8">
        <div class="panel-dark p-6 md:p-10 shadow-2xl space-y-6">
          <ChaosTimelineStrip client:only="react" />
          <LiveTopologyMap client:only="react" />
          <ChaosImpactBanner client:only="react" />
          <div class="border-t border-white/[0.06] pt-6">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Wire feed · every /api/* the BFF handled
            </div>
            <LabRequestFeed client:only="react" />
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────────────────────────────────────
         ZONE 2 — PROVE invariants over time
         Scoreboard + pattern runners share one container. They answer
         the same question (is the system provably correct?) at two
         granularities: invariant claims + per-pattern traffic.
         ───────────────────────────────────────────────────────────── -->
    <section id="runners" class="py-12 lg:py-14 border-t border-border" data-reveal>
      <PanelHeader
        eyebrow="Prove"
        title="Continuous invariants under load and under chaos."
        summary="Three live invariant proofs running real loops, plus nine pattern runners firing real traffic. Pause a dependency — the affected ones turn red, but the invariants do not violate."
      />
      <div class="container px-6 lg:px-8">
        <div class="panel-dark p-6 md:p-8 shadow-2xl space-y-6">
          <ResilienceScoreboard client:only="react" />
          <div class="border-t border-white/[0.06] pt-6">
            <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
              Pattern runners · each loop fires its own real traffic
            </div>
            <LabAutoRunners client:only="react" />
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────────────────────────────────────────────────────
         ZONE 3 — INSPECT raw signals & drive it yourself
         Quieter chrome. Live metrics + sparklines side by side, then
         the interactive demo hub for visitors who want to drive a
         single pattern by hand.
         ───────────────────────────────────────────────────────────── -->
    <section id="demo" class="py-12 lg:py-14 border-t border-border" data-reveal>
      <PanelHeader
        eyebrow="Inspect"
        title="Raw signals & drive it yourself."
        summary="Live measurements on the left, RPS + p99 sparklines on the right. Below: interactive demos for visitors who want to pick scenarios one at a time."
      />
      <div class="container px-6 lg:px-8 space-y-6">
        <div class="panel-dark p-5 md:p-6 shadow-2xl">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                Live measurements · trailing 30s
              </div>
              <LiveMetricsPanel client:only="react" />
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-[0.22em] text-muted/70 mb-3">
                RPS + p99 · trailing 60s
              </div>
              <LiveSparklines client:only="react" />
            </div>
          </div>
        </div>
        <div class="panel-dark p-6 md:p-10 shadow-2xl">
          <DemoHub client:only="react" />
        </div>
      </div>
    </section>

    <!-- Footer return -->
    <section class="py-16 border-t border-border" data-reveal>
      <div class="container-prose px-6 lg:px-8 text-center">
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-5 py-3 bg-primary text-base font-medium rounded-md hover:bg-secondary transition-colors"
          style="color: rgb(var(--color-base))"
        >
          Get in touch
          <span>→</span>
        </a>
        <div class="mt-4 text-sm text-muted">
          <a href="/" class="hover:text-primary transition-colors">
            ← back to chidionyema.dev
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
