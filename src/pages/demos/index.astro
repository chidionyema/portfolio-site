---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DemoHub } from '../../components/demo/DemoHubLite';
import { DemoStatusGrid } from '../../components/demo/DemoStatusGrid';
---

<BaseLayout
  title="Live Demos | Chidi Onyema"
  description="13 interactive demos hitting a live .NET 9 microservice cluster. Saga orchestration, idempotency, circuit breakers, Vault rotation, GDPR erasure, CDC search — every request touches real infrastructure."
  ogImage="/og-demos.png"
>
  <main class="pt-20 overflow-x-hidden">
    <div class="container px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-primary mb-2">Interactive demos</h1>
        <p class="text-secondary max-w-2xl">
          Each demo solves a real problem — failed payments, duplicate charges, cache
          stampedes, GDPR compliance. Click a button and it runs against the live
          cluster (Fly.io, Postgres, RabbitMQ). Nothing is mocked.
        </p>
      </div>
      <DemoStatusGrid client:load />
      <DemoHub client:load />
    </div>
  </main>
</BaseLayout>
