---
import SiteNav from '../components/system/SiteNav.astro';
import { StatusStrip } from '../components/system/StatusStrip';
// LiveEnvironmentToast removed — the hero topology map and the live
// console dock both prove the cluster is live; a third "we're online"
// toast was visual noise that overlapped the dock on first paint.
import { LiveConsoleDock } from '../components/system/LiveConsoleDock';
import { getHealthSnapshot } from '../lib/api/demo-client';

const initialHealth = await getHealthSnapshot().catch(() => undefined);

// Self-hosted fonts. Astro/Vite emits these as content-hashed .woff2 in
// /_astro/*. Inter and JetBrains Mono use latin-only subsets directly;
// Fraunces Variable only ships 3 unicode subsets (vietnamese / latin-ext /
// latin) so the browser's unicode-range matching auto-loads only latin.
import '@fontsource-variable/fraunces';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Chidi Onyema | Senior .NET Contractor",
  description = "Distributed .NET microservices in production. Live demos, real metrics, source on GitHub. Senior contractor in London.",
  ogImage = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://chidionyema.dev').toString();
const ogImageURL = new URL(ogImage, Astro.site ?? 'https://chidionyema.dev').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Theme: dark-only. Light mode is deprecated until token parity lands
         (see UI_AND_DEMO_PLAN.md T5.1). The bootstrap script + .light class
         swap have been removed; the toggle in SiteNav and the entries in
         CommandPalette are gone for the same reason. -->

    <!-- Favicon - inline SVG for zero requests -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236366f1' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z'/%3E%3C/svg%3E" />

    <!-- Fonts are self-hosted. See src/styles/global.css for the @fontsource imports. -->


    <!-- Critical CSS inlined. Light editorial palette: cream background,
         warm-black text, deep-navy accent. The dark "operations console"
         panels (topology, dock, demo cards) keep their own dark surface
         scoped via the `.panel-dark` class so they read as embedded
         device screens within the article-style layout. -->
    <style is:inline>
      /* Light editorial palette on :root. Components use semantic
         classes (text-primary, bg-surface, border-border) and tailwind
         resolves them via CSS variables — flip the variables inside a
         scope and every consumer adapts without further changes. */
      :root{
        --color-base: 250 250 247;
        --color-surface: 255 255 255;
        --color-surface-warm: 244 241 234;
        --color-panel-dark: 11 11 14;

        --color-accent: 91 63 214;
        --color-accent-light: 124 92 255;

        --color-text-primary: 20 17 15;
        --color-text-secondary: 61 56 51;
        --color-text-muted: 107 102 94;

        --color-border: 232 229 222;
        --color-border-strong: 217 212 200;

        --hairline: 1px solid rgb(20 17 15 / 0.08);
      }

      /* Embedded "ops console" surfaces. Override the variables so any
         component rendered inside a `.panel-dark` (live topology,
         demo cards, dock, Grafana panels) renders correctly without
         changing its class names. */
      .panel-dark{
        --color-base: 11 11 14;
        --color-surface: 19 19 26;
        --color-surface-warm: 22 22 30;
        --color-text-primary: 245 245 240;
        --color-text-secondary: 200 200 195;
        --color-text-muted: 130 140 155;
        --color-border: 255 255 255 / 0.08;
        --color-border-strong: 255 255 255 / 0.16;
        --color-accent: 124 92 255;
        --color-accent-light: 167 139 250;
        background: rgb(var(--color-base));
        color: rgb(var(--color-text-primary));
        border-radius: 16px;
      }

      *,*::before,*::after{box-sizing:border-box}
      html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;overflow-x:hidden}
      body{
        margin:0;
        font-family:Inter,-apple-system,BlinkMacSystemFont,system-ui,sans-serif;
        background:rgb(var(--color-base));
        color:rgb(var(--color-text-primary));
        -webkit-font-smoothing:antialiased;
        font-feature-settings: "kern", "liga", "calt", "ss01";
        overflow-x:hidden;
      }
      .container{width:100%;max-width:1100px;margin:0 auto}
      .container-prose{width:100%;max-width:760px;margin:0 auto}
      .font-display{
        font-family:"Fraunces Variable",Fraunces,ui-serif,Georgia,serif;
        font-feature-settings: "ss01", "ss02";
        letter-spacing:-0.02em;
      }

      /* `.surface` and `.glass` utilities the existing demo components
         still reference — render correctly on whichever surface they
         find themselves on via the CSS variables. */
      .surface{
        background: rgb(var(--color-surface));
        border: 1px solid rgb(var(--color-border));
        border-radius: 1rem;
      }
      .glass{
        background: rgb(var(--color-surface));
        border: 1px solid rgb(var(--color-border));
        border-radius: 1rem;
      }
      .glass-subtle{
        background: rgb(var(--color-surface-warm));
        border: 1px solid rgb(var(--color-border));
        border-radius: 0.75rem;
      }
      /* Inside dark panels, surface/glass become a slightly elevated
         dark layer instead of plain white. */
      .panel-dark .surface,
      .panel-dark .glass{
        background: rgb(255 255 255 / 0.03);
        border-color: rgb(255 255 255 / 0.08);
      }
      .panel-dark .glass-subtle{
        background: rgb(255 255 255 / 0.02);
        border-color: rgb(255 255 255 / 0.06);
      }

      @keyframes fade-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
      .animate-fade-in{animation:fade-in 0.5s ease-out forwards}
    </style>

    <script type="application/ld+json" is:inline>{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Chidi Onyema",
      "jobTitle": "Senior .NET Engineer",
      "url": "https://chidionyema.dev",
      "sameAs": ["https://github.com/chidionyema", "https://linkedin.com/in/chidionyema"]
    })}</script>

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chidi Onyema, Senior .NET Contractor" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>
  </head>
  <body>
    <StatusStrip initialSnapshot={initialHealth} client:load />
    <SiteNav />

    <slot />

    <LiveConsoleDock client:idle />

    <!--
      Site-nav visibility. On pages with a [data-hero] element, the nav stays
      hidden until the user scrolls roughly past it; on every other page (deep
      dives, 404, future routes) the nav shows immediately.
    -->
    <script is:inline>
      (function () {
        var nav = document.getElementById('site-nav');
        if (!nav) return;
        var hero = document.querySelector('[data-hero]');
        if (!hero) {
          nav.setAttribute('data-show', 'true');
          return;
        }
        var threshold = function () {
          return hero.getBoundingClientRect().bottom + window.scrollY - 80;
        };
        var t = threshold();
        var update = function () {
          nav.setAttribute('data-show', String(window.scrollY > t));
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', function () { t = threshold(); update(); });
        update();
      })();
    </script>

    <!--
      Scroll-reveal init. One IntersectionObserver, observes every [data-reveal].
      Honors prefers-reduced-motion by revealing everything immediately.
    -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

  </body>
</html>
