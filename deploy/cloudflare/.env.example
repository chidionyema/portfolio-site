# Copy to deploy/cloudflare/.env.local and fill in.
# .env.local matches the .env.* gitignore rule — never committed.
# The wizard at deploy/cloudflare/up.sh prompts for these on first run
# and writes them here.

# Cloudflare Pages project name (becomes <name>.pages.dev).
# Default 'ritualworks' aligns with the BFF's CORS allowlist defaults.
# Change only if you've already created the project under a different name.
CLOUDFLARE_PAGES_PROJECT=ritualworks

# Production API URL — the deployed BFF on Fly.io.
# The build inlines this into the bundle (Astro PUBLIC_ prefix).
PUBLIC_API_URL=https://ritualworks-bffweb.fly.dev

# Optional: custom domain for the UI. Leave blank to use the
# auto-generated <project>.pages.dev URL.
CUSTOM_DOMAIN=
